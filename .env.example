# Google Search Console verification
VITE_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools verification (balise msvalidate.01)
VITE_BING_SITE_VERIFICATION=

# IndexNow (Bing + Yandex) — clé affichée par Bing Webmaster Tools > IndexNow
INDEXNOW_KEY=

# Optional analytics identifier
VITE_ANALYTICS_ID=

# Administration privée Supabase — ne jamais utiliser une clé service_role ici
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
