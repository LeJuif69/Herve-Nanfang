# Google Search Console verification
VITE_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools verification (balise msvalidate.01)
VITE_BING_SITE_VERIFICATION=

# IndexNow (Bing + Yandex) — clé affichée par Bing Webmaster Tools > IndexNow
INDEXNOW_KEY=

# Optional analytics identifier
VITE_ANALYTICS_ID=

# Administration privée Supabase — le relais serveur vérifie Auth et les droits RLS avec ces variables.
# Ne jamais utiliser une clé service_role dans le frontend.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ─────────────────────────────────────────────────
# Lead Magnet & Email (Vercel Serverless Functions)
# ─────────────────────────────────────────────────

# URL de base du site (sans slash final)
VITE_SITE_URL=https://hervenanfang.art

# Brevo (Sendinblue) — API & Listes marketing
# Clé API : https://app.brevo.com/settings/keys/api
BREVO_API_KEY=

# ID de la liste Brevo pour le segment « Journal & Musicien Augmenté » (ex: 3)
BREVO_LIST_JOURNAL_ID=

# ID de la liste Brevo pour le segment « Booking & Pro » (ex: 4)
BREVO_LIST_BOOKING_ID=

# ID du template Brevo pour le Double Opt-in (optionnel — ex: 12)
# Si omis, l'inscription est directe avec envoi immédiat du livrable
BREVO_DOI_TEMPLATE_ID=

# Resend — fallback si Brevo non configuré
# Obtenez votre clé sur https://resend.com/api-keys
RESEND_API_KEY=

# Supabase service_role (côté serveur uniquement — ne jamais exposer au client)
# Utilisé pour stocker les leads dans la table `leads`
SUPABASE_SERVICE_KEY=

# ─────────────────────────────────────────────────
# Google Analytics 4 — Measurement Protocol
# ─────────────────────────────────────────────────

# Measurement ID GA4 (ex: G-XXXXXXXXXX)
VITE_GA4_MEASUREMENT_ID=

# API Secret GA4 (Measurement Protocol — côté serveur uniquement)
# Obtenez-le sur : GA4 Admin > Data Streams > Measurement Protocol API secrets
GA4_API_SECRET=
