{
  "name": "herve-nanfang",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/prerender.mjs && node scripts/generate-rss.mjs && node scripts/fetch-yt-rss.js && node scripts/submit-indexnow.mjs --auto",
    "preview": "vite preview",
    "generate:rss": "node scripts/generate-rss.mjs",
    "test": "npx tsx scripts/test-distribution-system.mjs",
    "test:admin": "npx tsx scripts/test-admin.mjs",
    "test:audit": "npx tsx scripts/test-audit.mjs",
    "test:images": "npx tsx scripts/test-image-editor.mjs",
    "test:health": "node scripts/test-api-health.mjs",
    "test:all": "node scripts/test-api-vercel-compat.mjs && node scripts/test-track-event-consent.mjs && node scripts/test-api-health.mjs && npx tsx scripts/test-distribution-system.mjs && npx tsx scripts/test-audit.mjs && npx tsx scripts/test-image-editor.mjs && npx tsx scripts/test-admin.mjs",
    "typecheck": "tsc --noEmit",
    "generate:sitemap": "node scripts/generate-sitemap.mjs",
    "submit:indexnow": "node scripts/submit-indexnow.mjs",
    "audit": "py -3 scripts/audit.py",
    "photos": "python3 scripts/import-photos.py",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:staging": "cross-env PLAYWRIGHT_BASE_URL=https://hervenanfang.art playwright test"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.7",
    "@playwright/test": "^1.48.0",
    "cross-env": "^7.0.3"
  }
}
