{
  "name": "herve-nanfang",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/prerender.mjs && node scripts/submit-indexnow.mjs --auto",
    "preview": "vite preview",
    "test": "npx tsx scripts/test-distribution-system.mjs",
    "test:admin": "npx tsx scripts/test-admin.mjs",
    "test:audit": "npx tsx scripts/test-audit.mjs",
    "test:images": "npx tsx scripts/test-image-editor.mjs",
    "test:all": "npx tsx scripts/test-distribution-system.mjs && npx tsx scripts/test-audit.mjs && npx tsx scripts/test-image-editor.mjs && npx tsx scripts/test-admin.mjs",
    "typecheck": "tsc --noEmit",
    "generate:sitemap": "node scripts/generate-sitemap.mjs",
    "submit:indexnow": "node scripts/submit-indexnow.mjs",
    "audit": "py -3 scripts/audit.py",
    "photos": "python3 scripts/import-photos.py"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "omniroute": "^3.8.51",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.7"
  }
}
